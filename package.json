{
  "name": "discord-connections-bot",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/bot.ts",
    "dev": "bun --watch src/bot.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "history:fetch": "bun run scripts/fetch-history.ts",
    "history:analyze": "bun run scripts/analyze.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "discord.js": "14.28.1",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.5",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
